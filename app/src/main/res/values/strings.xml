    <string name="app_name" translatable="false">KTX Driver</string>
    <!-- The app's half of the app/site pairing Chrome checks for navigator.getInstalledRelatedApps():
         the site links /app/manifest.webmanifest (related app = this package) and must be the host the
         pages are actually served from (www, not driver.withktx.com, which redirects). -->
    <string name="asset_statements" translatable="false">[{\"relation\": [\"delegate_permission/common.handle_all_urls\"], \"target\": {\"namespace\": \"web\", \"site\": \"https://www.withktx.com\"}}]</string>
