    <string name="setup_title">Set up KTX Driver</string>
    <string name="setup_intro">Allow these once so your truck\'s location is sent while you drive, even with the screen off.</string>
    <string name="setup_location_title">Location: Allow all the time</string>
    <string name="setup_location_desc">On the next screen choose \"Allow all the time\". Needed to send your location with the screen off.</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_desc">Shows \"KTX: Sending location\" while your location is being sent.</string>
    <string name="setup_battery_title">No battery restriction</string>
    <string name="setup_battery_desc">Stops Android from pausing the app on long drives.</string>
    <string name="setup_updates_title">Allow app updates</string>
    <string name="setup_updates_desc">On the next screen turn on the switch for KTX Driver so new versions install right in the app.</string>
    <string name="disclosure_title">Location sharing</string>
    <string name="disclosure_message">KTX Driver collects your phone\'s location to share your truck\'s position with KTX Transport while you are carrying a load, including when the app is closed or not in use.\n\nLocation is sent only from pickup until your last delivery of the day, and is used only for tracking your loads.</string>
    <string name="disclosure_accept">Continue</string>
    <string name="disclosure_decline">No thanks</string>
    <string name="battery_guide_title">Battery</string>
    <string name="battery_guide_message">So that location keeps sending on long drives: on the next screen tap Battery, choose Unrestricted, then come back.</string>
    <string name="battery_guide_open">Open settings</string>
